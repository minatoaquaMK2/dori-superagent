stateDiagram-v2
  state "Legend" as legend {
    lg0: Breaks ChatNeverApproves or DisconnectedRejectsNewWork or TerminalOwnsWorkerApproval
    lg1: Path to the ChatNeverApproves or DisconnectedRejectsNewWork or TerminalOwnsWorkerApproval bug
  }
  class lg0 breaks
  class lg1 bugPath
  s0: Chat connected
  s1: Bridge answered worker approval
  s2: Chat approved an operation
  s3: Connection lost
  s4: Disconnected message accepted
